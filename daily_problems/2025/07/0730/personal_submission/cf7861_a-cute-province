#define y second
#define int long long
#define cute_prov0nce main
using namespace std;
typedef pair<int, int> PII;
using i64 = long long;
const int N = 1e6 + 10;
const int mod = 998244353;

void solve()
{
    int n;
    cin >> n;
    int k1, k2;
    vector<array<int, 2>> dp(n, array<int, 2>{0, 0}), cnt(n, array<int, 2>{0, 0});
    cin >> k1;
    vector<int> s1(k1);
    for(auto &x : s1)cin >> x;
    cin >> k2;
    vector<int> s2(k2);
    for(auto &x : s2)cin >> x;
    dp[0][0] = dp[0][1] = 2;
    auto f = [&](auto &f, int pos, int person)->void{
        if(person){         
            for(auto u : s1){
                int last_pos = (pos + n - u)%n;
                if(dp[last_pos][0] == 0){
                    if(dp[pos][1] == 2)dp[last_pos][0] = 1, f(f, last_pos, 0);
                    else {
                        cnt[last_pos][0]++;
                        if(cnt[last_pos][0] == k1)dp[last_pos][0] = 2, f(f, last_pos, 0);
                    }
                }
            }  
        }
        else{
            for(auto u : s2){
                int last_pos = (pos + n - u)%n;
                if(dp[last_pos][1] == 0){
                    if(dp[pos][0] == 2)dp[last_pos][1] = 1, f(f, last_pos, 1);
                    else {
                        cnt[last_pos][1]++;
                        if(cnt[last_pos][1] == k2)dp[last_pos][1] = 2, f(f, last_pos, 1);
                    }
                }
            }
        }
    };
    f(f, 0, 1);
    f(f, 0, 0);
    vector<string> str = {"Loop", "Win", "Lose"};
    for(int i = 0; i <= 1; i++){
        for(int j = 1; j < n; j ++)cout << str[dp[j][i]] <<' ';
        cout << '\n';
    }
}
signed cute_prov0nce()
{
     ios::sync_with_stdio(0), cin.tie(0), cout.tie(0);
     // 取消同步流


     int t;
     //cin >> t;
     t = 1;
     while (t--)
     {
          solve();
     }

     return 0;
}
