using i64 = long long;
const int N = 1e6 + 10;
const int mod = 998244353;

void solve()
{
    int n;
    cin >> n;
    int h;
    for(int i = N; i >= 0; i --){
        if((n - (2 * i + 3*i*(i-1)/2) ) < 0)continue;
        if((n - (2 * i + 3*i*(i-1)/2) )% 3 == 0){
            h = i;
            break;
        }
    } 
    cout << (h + 2)/3 << '\n';
}
signed cute_prov0nce()
{
     ios::sync_with_stdio(0), cin.tie(0), cout.tie(0);
     // 取消同步流
     int t;
     //cin >> t;
     t = 1;
     while (t--)
     {
          solve();
     }

     return 0;
}
